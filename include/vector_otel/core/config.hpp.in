#include <cstddef>

namespace vector_otel::core {

// Hard ceiling for the configurable payload limit.
inline constexpr std::size_t kAbsoluteMaxPayloadBytes = 536870912;
// Configured maximum uncompressed JSON payload in bytes (VECTOR_OTEL_MAX_PAYLOAD_BYTES).
inline constexpr std::size_t kMaxPayloadBytes = @VECTOR_OTEL_MAX_PAYLOAD_BYTES@;
// Fixed per-call cap on incoming records (log records / spans / metric data points).
inline constexpr std::size_t kMaxIncomingRecords = 2048;
// Bytes reserved after the input for simdjson's SIMD over-read; must cover SIMDJSON_PADDING.
inline constexpr std::size_t kPayloadPaddingBytes = 64;

static_assert(kMaxPayloadBytes >= 1 && kMaxPayloadBytes <= kAbsoluteMaxPayloadBytes,
              "VECTOR_OTEL_MAX_PAYLOAD_BYTES must be in 1..536870912");
static_assert(kMaxPayloadBytes <= static_cast<std::size_t>(-1) - kPayloadPaddingBytes,
              "payload limit plus padding must not overflow std::size_t");

}  // namespace vector_otel::core
