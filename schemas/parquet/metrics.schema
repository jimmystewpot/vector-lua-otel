message MetricRecord {
  required binary MetricName (STRING);
  optional binary MetricDescription (STRING);
  optional binary MetricUnit (STRING);
  required binary MetricType (STRING);
  required binary ServiceName (STRING);
  optional int64 AggregationTemporality;
  optional boolean IsMonotonic;
  optional binary ResourceAttributes (STRING);
  optional binary ScopeName (STRING);
  optional binary ScopeVersion (STRING);
  optional binary ScopeAttributes (STRING);
  optional binary Attributes (STRING);
  optional binary StartTimeUnix (STRING);
  required binary TimeUnix (STRING);
  optional double Value;
  optional binary Histogram (STRING);
  optional binary ExponentialHistogram (STRING);
  optional binary Summary (STRING);
  optional int64 Flags;
  optional binary Exemplars (STRING);
  required binary processed_at (STRING);
}
